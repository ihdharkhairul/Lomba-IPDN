# =====================================================================
# LAPORIN - contoh environment variable.
# Salin file ini menjadi `.env.local` (atau `.env`) lalu isi nilainya.
# JANGAN commit file .env / .env.local ke repository.
# =====================================================================

# ---------------------------------------------------------------------
# SERVER-SIDE (rahasia, TIDAK pernah dikirim ke browser)
# ---------------------------------------------------------------------

# API key Google Gemini. Buat di https://aistudio.google.com/apikey
# Hanya dibaca oleh server Express (server/ai/geminiProvider.ts).
GEMINI_API_KEY=""

# Model Gemini untuk analisis foto (multimodal).
# Catatan: gemini-2.5-flash dijadwalkan pensiun 16 Oktober 2026.
GEMINI_MODEL="gemini-3.5-flash"

# (Opsional) Model cadangan bila model utama terus gagal karena Google sedang padat (error 503).
# Contoh: "gemini-3.1-flash-lite" — pastikan namanya ada di daftar model akun Anda (AI Studio).
GEMINI_FALLBACK_MODEL=""

# Mode AI:
#   REAL_AI -> memanggil Gemini sungguhan (butuh GEMINI_API_KEY)
#   MOCK_AI -> hasil simulasi deterministik, ditandai "Mode demo" di UI (tidak melihat isi foto)
#   YOLO    -> model YOLO lokal (.onnx). Butuh file model buatan Anda, lihat docs/YOLO.md
#   HYBRID  -> YOLO lebih dulu, lalu Gemini; diterima hanya bila KEDUANYA setuju
AI_MODE="REAL_AI"

# --- Khusus AI_MODE=YOLO / HYBRID -------------------------------------
# Lokasi model hasil `yolo export format=onnx` dan file pemetaan kelas.
YOLO_MODEL_PATH="models/yolo/best.onnx"
YOLO_CLASSES_PATH="models/yolo/classes.json"
YOLO_INPUT_SIZE="640"
# "stretch" = regangkan foto ke 640x640 (samakan bila data latih Roboflow berlabel "Stretch to 640x640").
# "letterbox" = jaga rasio foto (default Ultralytics bila training dari foto asli).
YOLO_RESIZE="letterbox"
# Ambang skor deteksi (0-1) dan ambang NMS.
YOLO_CONF="0.25"
YOLO_IOU="0.45"

# Batas permintaan analisis AI per IP per menit (proteksi kuota).
AI_RATE_LIMIT_PER_MINUTE="20"

# Port server (default 3000).
PORT="3000"

# Set "1" bila server berjalan di belakang reverse proxy (Cloud Run, Nginx, dll)
# agar IP klien terbaca benar untuk rate limit.
TRUST_PROXY=""

# ---------------------------------------------------------------------
# CLIENT-SIDE (diawali VITE_, ikut ter-bundle ke browser)
# ---------------------------------------------------------------------

# Penyedia peta: "osm" (OpenStreetMap, GRATIS, tanpa key) atau "google" (Google Maps, butuh key + billing).
# Kosongkan = otomatis: pakai Google bila VITE_GOOGLE_MAPS_API_KEY terisi, selain itu OpenStreetMap.
VITE_MAP_PROVIDER=""

# (Opsional, hanya bila memakai Google Maps) Google Maps JavaScript API key.
# PENTING: key ini terlihat di browser, jadi WAJIB dibatasi di Google Cloud Console:
#   - Application restriction : HTTP referrers (domain aplikasi Anda saja)
#   - API restriction         : Maps JavaScript API + Geocoding API
VITE_GOOGLE_MAPS_API_KEY=""

# (Opsional) Map ID untuk AdvancedMarker. Default "DEMO_MAP_ID" (hanya untuk development).
VITE_GOOGLE_MAPS_MAP_ID=""

# Mode demo: menampilkan alat bantu demo (simulasi offline & simulasi status petugas).
# Biarkan kosong / "false" untuk pengguna sebenarnya.
VITE_DEMO_MODE="false"

# Mode ketat validasi foto (default aktif). Foto yang bukan kerusakan jalan ATAU belum meyakinkan
# tidak bisa dikirim; pengguna harus mengambil foto ulang. "false" = boleh "tetap kirim" untuk diperiksa petugas.
VITE_AI_STRICT="true"
